# Animetta environment inputs
# Copy to .env. Provider selection belongs only in config/animetta.yaml.

# Runtime profile: test (mock), smoke (remote APIs), selftest (local Qwen TTS), production.
ANIMETTA_PROFILE=test
ANIMETTA_HOST=127.0.0.1
ANIMETTA_PORT=12394

# Remote API credentials used by smoke/production profiles.
DEEPSEEK_API_KEY=
MIMO_API_KEY=
DASHSCOPE_API_KEY=
QWEN_TTS_API_KEY=

# Qwen TTS service endpoint as seen by the core application.
QWEN_TTS_URL=http://127.0.0.1:8766

# Qwen worker assets. Production Compose mounts these read-only.
HF_CACHE_DIR=/absolute/path/to/huggingface_cache
ALICE_REF_AUDIO=/absolute/path/to/alice_ref.wav

# Optional feature inputs (not provider selectors).
RVC_PATH=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Optional notifier sidecar inputs.
NOTIFIER_DISCORD_WEBHOOK_URL=
NOTIFIER_FEISHU_WEBHOOK_URL=
NOTIFIER_FEISHU_SIGN_SECRET=
NOTIFIER_SMTP_HOST=smtp.gmail.com
NOTIFIER_SMTP_PORT=587
NOTIFIER_SMTP_USER=
NOTIFIER_SMTP_PASSWORD=
NOTIFIER_EMAIL_FROM=
NOTIFIER_EMAIL_TO=
