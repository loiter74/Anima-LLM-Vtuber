# Animetta environment inputs
# Copy to .env. Provider selection belongs only in config/animetta.yaml.

# Runtime profile: test (mock), smoke (remote APIs), selftest (local Qwen TTS), production.
ANIMETTA_PROFILE=production
ANIMETTA_HOST=127.0.0.1
ANIMETTA_PORT=12394

# Remote API credentials used by smoke/production profiles.
DEEPSEEK_API_KEY=
# Machine-only credential for Bearer and Socket.IO control clients.
ANIMETTA_ACCESS_TOKEN=
# Browser account. Compose defaults to admin / animetta when these are empty.
# Before LAN or public exposure, replace the password with a scrypt-v1 hash
# generated by hash_password. The container never receives a plaintext password.
ANIMETTA_AUTH_USERNAME=admin
ANIMETTA_AUTH_PASSWORD_HASH=
# Use a strong URL-safe value for the Compose default URL.
ANIMETTA_REDIS_PASSWORD=
# Optional external Redis override. Leave empty to use the Compose Redis service.
# ANIMETTA_REDIS_URL=rediss://user:password@redis.example:6379/0
MIMO_API_KEY=
DASHSCOPE_API_KEY=
QWEN_TTS_API_KEY=

# Host-local Qwen TTS endpoint. Docker Compose overrides this to
# http://host.docker.internal:8767 for the application container.
QWEN_HOST_TTS_URL=http://127.0.0.1:8767

# Optional feature inputs (not provider selectors).
RVC_PATH=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Optional notifier sidecar inputs.
NOTIFIER_DISCORD_WEBHOOK_URL=
NOTIFIER_FEISHU_WEBHOOK_URL=
NOTIFIER_FEISHU_SIGN_SECRET=
NOTIFIER_SMTP_HOST=smtp.gmail.com
NOTIFIER_SMTP_PORT=587
NOTIFIER_SMTP_USER=
NOTIFIER_SMTP_PASSWORD=
NOTIFIER_EMAIL_FROM=
NOTIFIER_EMAIL_TO=
