{
  "name": "animetta-desktop",
  "version": "2.0.0",
  "description": "Animetta Desktop - AI Virtual Companion with Live2D",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "vue-tsc --noEmit && vite build && node scripts/assert-live-build.mjs",
    "build:sites": "pnpm build && node scripts/package-sites-worker.mjs",
    "build:electron": "vite build && electron-builder",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:sites": "node --test tests/sites-worker.test.mjs tests/sites-package.test.mjs"
  },
  "dependencies": {
    "@pixi/core": "6.5.10",
    "@pixi/display": "6.5.10",
    "@pixi/math": "6.5.10",
    "@pixi/utils": "6.5.10",
    "chart.js": "^4.5.1",
    "d3-force": "^3.0.0",
    "gsap": "^3.15.0",
    "pinia": "^2.3.1",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.33",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/d3-force": "^3.0.10",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.9",
    "@volar/typescript": "^2.4.28",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^10.0.3",
    "electron": "39.8.10",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.7.0",
    "happy-dom": "^20.10.6",
    "playwright": "^1.60.0",
    "prettier": "3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.64.0",
    "unocss": "^0.64.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.2.12",
    "wait-on": "^8.0.5"
  }
}
