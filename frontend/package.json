{
  "name": "animetta-desktop",
  "version": "2.0.0",
  "description": "Animetta Desktop - AI Virtual Companion with Live2D",
  "type": "module",
  "main": "electron/main.cjs",
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "vue-tsc --noEmit && vite build",
    "build:electron": "vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@pixi/core": "6.5.10",
    "@pixi/display": "6.5.10",
    "@pixi/math": "6.5.10",
    "@pixi/utils": "6.5.10",
    "chart.js": "^4.5.1",
    "gsap": "^3.15.0",
    "pinia": "^2.2.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.0",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.10",
    "concurrently": "^9.1.2",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.9.0",
    "playwright": "^1.60.0",
    "typescript": "^5.7.0",
    "unocss": "^0.64.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.6",
    "vue-tsc": "^2.2.0",
    "wait-on": "^8.0.3"
  }
}
