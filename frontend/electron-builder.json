{
  "appId": "com.animetta.live-stream",
  "productName": "Animetta Live",
  "directories": {
    "output": "release"
  },
  "files": ["dist/**/*", "electron/**/*", "public/**/*"],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/favicon.svg"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Animetta Live"
  },
  "portable": {
    "artifactName": "AnimettaLive-${version}-portable.exe"
  }
}
